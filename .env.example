# Form API + Cognito (from `npx sst deploy` outputs in EmailServer).
# Mirror these on the Vercel project (Production, Preview, Development).
NEXT_PUBLIC_API_URL=https://api.trashbox.io
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=us-east-2

# Public form API key for the contact form (rotate via portal or EmailServer scripts/rotate-api-key.ts)
# Visible in the browser bundle — protect with allowedOrigins on the Form API client.
NEXT_PUBLIC_FORM_API_KEY=
